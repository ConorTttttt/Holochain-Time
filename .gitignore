/target
*.dna
*.happ
*.webhapp

# Local test reports may contain host-specific metadata.
/test-reports/

/integration/conductor/target
/integration/load/target

# Never stage local production approval records, release candidate archives or receipts.
/deployment/private/
/deployment/local/
/release-artifacts/
/release-evidence/

# Sprint 14B: local public test-alliance plans and potentially sensitive receipts.
/integration/unyt/private/
/integration/unyt/local-evidence/

# Sprint 25 private diagnostic material never belongs in a Git commit.
/ops-private/
/ops-evidence/
/scripts/ops/__pycache__/

# Generated Python bytecode is never source. Tracked .pyc files were rewritten
# by test runs on fresh checkouts (stale recorded mtimes), dirtying exact-commit
# worktrees and blocking acceptance gates; they are also opaque to review.
__pycache__/
*.py[cod]
