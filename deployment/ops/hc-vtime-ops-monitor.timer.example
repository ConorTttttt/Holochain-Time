# Example only. Copy to reviewed systemd unit name before installation.
[Unit]
Description=Evaluate Holochain Time ops health every 30 seconds

[Timer]
OnBootSec=30s
OnUnitActiveSec=30s
AccuracySec=1s
RandomizedDelaySec=2s
Persistent=true
Unit=hc-vtime-ops-monitor.service

[Install]
WantedBy=timers.target
